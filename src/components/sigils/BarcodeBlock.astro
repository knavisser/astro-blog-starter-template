---
interface Props {
	size?: number;
	class?: string;
	seed?: string;
}

const { size = 120, class: className = "", seed = "BAD-JUJU" } = Astro.props;

function hash(s: string) {
	let h = 2166136261;
	for (let i = 0; i < s.length; i++) {
		h ^= s.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	return h >>> 0;
}

const h = hash(seed);
const bars: { x: number; w: number; tall: boolean }[] = [];
let x = 0;
let cursor = h;
while (x < 100) {
	cursor = (cursor * 1664525 + 1013904223) >>> 0;
	const w = 0.6 + ((cursor % 7) / 2);
	const tall = ((cursor >> 4) & 1) === 1;
	if (cursor & 1) {
		bars.push({ x, w, tall });
	}
	x += w + 0.4;
}
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 100 30"
	width={size}
	height={(size * 30) / 100}
	preserveAspectRatio="none"
	class:list={["sigil sigil--barcode", className]}
	aria-hidden="true"
>
	<rect x="0" y="0" width="100" height="30" fill="none" stroke="currentColor" stroke-width="0.4" />
	{
		bars.map((b) => (
			<rect
				x={b.x + 1}
				y={b.tall ? 4 : 8}
				width={b.w}
				height={b.tall ? 18 : 14}
				fill="currentColor"
			/>
		))
	}
</svg>

<style>
	.sigil--barcode {
		display: inline-block;
	}
</style>
