---
import { Icon as IconifyIcon } from "astro-icon/components";

interface Props {
	name: string;
	size?: number | string;
	class?: string;
}

const { name, size = 18, class: className = "" } = Astro.props;

const resolvedName = name.includes(":") ? name : `tabler:${name}`;
---

<IconifyIcon name={resolvedName} width={size} height={size} class={className} aria-hidden="true" />
