---
import {
	SITE_TITLE,
	ATELIER_COORDS,
	ATELIER_LABEL,
	CONTACT_EMAIL,
	SHOP_URL,
} from "../consts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="grid">
		<div class="col col--brand">
			<span class="brand-logo" aria-hidden="true"></span>
			<p class="display brand">{SITE_TITLE}</p>
			<p class="mono atelier">{ATELIER_LABEL}</p>
			<p class="mono coords">{ATELIER_COORDS}</p>
		</div>

		<div class="col col--nav">
			<p class="mono label">// SITE</p>
			<ul>
				<li><a href="/" data-cursor="link">HOME</a></li>
				<li><a href="/products" data-cursor="link">PRODUCTS</a></li>
				<li><a href="/about" data-cursor="link">ABOUT</a></li>
				<li><a href="/custom" data-cursor="link">CUSTOM</a></li>
				<li>
					<a href={SHOP_URL} target="_blank" rel="noopener noreferrer" data-cursor="link"
						>SHOP</a
					>
				</li>
			</ul>
		</div>

		<div class="col col--reach">
			<p class="mono label">// REACH</p>
			<ul>
				<li>
					<a href={`mailto:${CONTACT_EMAIL}`} data-cursor="link">{CONTACT_EMAIL}</a>
				</li>
				<li>
					<a href="/custom#summon" data-cursor="link">REQUEST A PIECE</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="stripe mono">
		<span>© {year} {SITE_TITLE.toUpperCase()}</span>
		<span>ALL ONE OF ONE · NO RESTOCKS</span>
		<span>BUILT IN THE LOWLANDS</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: var(--bone);
		padding: var(--space-7) var(--gutter) var(--space-4);
		margin-top: var(--space-7);
	}

	.grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: var(--space-5);
		max-width: var(--max-w);
		margin: 0 auto;
		padding-bottom: var(--space-6);
		border-bottom: 1px solid rgba(244, 241, 236, 0.15);
	}

	.col p,
	.col ul {
		margin: 0;
	}

	.col--brand {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: flex-start;
	}

	.brand-logo {
		display: block;
		width: 64px;
		height: 64px;
		margin-bottom: var(--space-2);
		background-color: var(--acid);
		-webkit-mask: url("/png/badjuju_logo.png") center / contain no-repeat;
		mask: url("/png/badjuju_logo.png") center / contain no-repeat;
	}

	.brand {
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		letter-spacing: 0.22em;
	}

	.atelier,
	.coords {
		opacity: 0.55;
		font-size: 0.7rem;
	}

	.label {
		opacity: 0.4;
		margin-bottom: var(--space-2) !important;
		font-size: 0.65rem;
	}

	ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.col--nav a,
	.col--reach a {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		opacity: 0.78;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	.col--nav a:hover,
	.col--reach a:hover {
		opacity: 1;
		color: var(--acid);
	}

	.stripe {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding-top: var(--space-3);
		font-size: 0.62rem;
		opacity: 0.55;
		flex-wrap: wrap;
		max-width: var(--max-w);
		margin: 0 auto;
	}

	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.col--brand {
			grid-column: 1 / -1;
		}
		.stripe {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
