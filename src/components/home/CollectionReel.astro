---
// A collection's best shots, in two states.
//
// In the page: the photos as a row of overlapping prints, in the same order
// as the strip, each one tucked under the one before it, with one button on
// top. Nothing pins or locks, so the page scrolls past as normal.
// Opened: the prints slide apart into a full-screen film strip with one photo
// in focus at a time. Every scroll, swipe or arrow key plays one full move to
// the next photo (the autofocus brackets lock on, the photo flashes). The X,
// Esc, or scrolling past either end slides them back into the row.
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import { objectLabel, PHOTO_WIDTHS } from "../../consts";
import { collections, getHomePagePhoto } from "../../lib/hoodies";

interface Props {
	/** key of the collection in src/data/hoodies.ts */
	collection: string;
	/** photos in order, as "<object number>/<file name>" */
	frames: string[];
}

const { collection: key, frames } = Astro.props;
const collection = collections.find((c) => c.key === key);
if (!collection) throw new Error(`CollectionReel: no collection "${key}" with hoodies in it.`);

const pad = (n: number, size = 2) => String(n).padStart(size, "0");
const shots = frames.map((ref) => {
	const { hoodie, image } = getHomePagePhoto(ref);
	const ratio = image.width / image.height;
	// The print in the row and the photo in the strip ask for the same file,
	// so one turns into the other without a reload or a change in sharpness.
	const sizes = `(max-width: 720px) 84vw, ${Math.round(640 * ratio)}px`;
	return { hoodie, image, ratio, sizes };
});
const filterUrl = `/portfolio?collection=${collection.key}`;
const viewerId = `reel-viewer-${collection.key}`;
---

<section class="reel" id={`collection-${collection.key}`} aria-labelledby={`reel-${collection.key}`} data-reel>
	<p class="display reel__ghost" aria-hidden="true">{collection.name}</p>

	<div class="reel__head mono">
		<h2 class="reel__kicker" id={`reel-${collection.key}`}>// COLLECTION · {collection.name}</h2>
		<p class="reel__meta">
			{collection.date && <span>SHOT {collection.date}</span>}
			<span>{pad(collection.count, 3)} PIECES</span>
		</p>
	</div>

	<div class="reel__stack">
		<button
			type="button"
			class="reel__open"
			data-reel-open
			data-cursor="link"
			aria-haspopup="dialog"
			aria-controls={viewerId}
		>
			<span>CHECK OUT THE COLLECTION</span>
			<Icon name="arrow-up-right" size={18} />
		</button>
		<ul class="stack" style={`--n: ${shots.length}`} aria-hidden="true">
			{
				shots.map(({ image, sizes }, i) => (
					<li class="stack__card" style={`--i: ${i}; z-index: ${shots.length - i}`} data-stack-card>
						<Image class="stack__img" src={image} alt="" widths={PHOTO_WIDTHS} sizes={sizes} draggable="false" />
					</li>
				))
			}
		</ul>
	</div>

	<div class="reel__foot mono">
		<span>{pad(shots.length)} PHOTOS</span>
		<a class="reel__all" href={filterUrl} data-cursor="link">
			ALL {collection.name} PIECES <Icon name="arrow-up-right" size={12} />
		</a>
	</div>

	<dialog class="viewer" id={viewerId} aria-label={`${collection.name} collection`} tabindex="-1" data-reel-viewer>
		<button type="button" class="viewer__close" data-reel-close data-cursor="link" aria-label="Close the collection">
			<Icon name="x" size={18} />
		</button>

		<p class="display viewer__ghost" aria-hidden="true">{collection.name}</p>

		<div class="viewer__head mono">
			<p class="viewer__kicker">// COLLECTION · {collection.name}</p>
			<p class="reel__meta">
				{collection.date && <span>SHOT {collection.date}</span>}
				<span>{pad(collection.count, 3)} PIECES</span>
			</p>
		</div>

		<div class="viewer__stage">
			<ol class="viewer__track" data-reel-track>
				{
					shots.map(({ hoodie, image, ratio, sizes }, i) => (
						<li class="viewer__item frame" style={`--ar: ${ratio.toFixed(4)}`} data-reel-item>
							<a
								class="frame__link"
								href={`/portfolio/${hoodie.id}`}
								data-cursor="zoom"
								data-cursor-label="VIEW"
							>
								<span class="frame__media">
									<Image
										class="frame__img"
										src={image}
										alt={`${objectLabel(hoodie.number)}, ${collection.name} collection`}
										widths={PHOTO_WIDTHS}
										sizes={sizes}
										draggable="false"
									/>
									<span class="frame__flash" aria-hidden="true" />
								</span>
								<span class="frame__cap mono">
									<span class="frame__no">{pad(i + 1)}</span>
									<span>{objectLabel(hoodie.number)}</span>
								</span>
							</a>
						</li>
					))
				}
				<li class="viewer__item viewer__end" data-reel-item>
					<a class="end__link" href={filterUrl} data-cursor="link">
						<span class="mono end__label">// {collection.name}</span>
						<span class="display end__title">
							ALL {pad(collection.count, 3)}
							<br />
							PIECES
						</span>
						<span class="mono end__cta">
							VIEW THE COLLECTION <Icon name="arrow-up-right" size={14} />
						</span>
					</a>
				</li>
			</ol>
		</div>

		<div class="viewer__foot mono">
			<span class="viewer__count" data-reel-count>{pad(1)} / {pad(shots.length)}</span>
			<span class="viewer__progress" aria-hidden="true"><span data-reel-bar></span></span>
			<a class="reel__all" href={filterUrl} data-cursor="link">
				ALL {collection.name} PIECES <Icon name="arrow-up-right" size={12} />
			</a>
		</div>
	</dialog>
</section>

<script>
	const STEP_SECONDS = 0.9; // one photo-to-photo move
	const GESTURE_GAP = 200; // ms without wheel events that ends a scroll gesture
	const SWIPE_MIN = 40; // px a finger has to travel to count as a swipe
	const FADE_MS = 280; // the page going dark behind the strip
	const FLY_IN_MS = 800;
	const FLY_OUT_MS = 650;
	const FLY_STAGGER_MS = 25; // between one print and the next

	interface LenisLike {
		stop(): void;
		start(): void;
	}
	// Base.astro's smooth scroller, if it's running
	const getLenis = () => (window as any).__lenis as LenisLike | null | undefined;

	const pad = (n: number) => String(n).padStart(2, "0");
	const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
	const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
	const flyEasing = "cubic-bezier(0.6, 0, 0.2, 1)";

	// One end of a photo's trip between the row and the strip: where it is on
	// screen, and how it's drawn there.
	interface Pose {
		rect: DOMRect;
		opacity: string;
		transform: string;
		shadow: string;
		edge: string;
	}

	function bindReel(section: HTMLElement) {
		const viewer = section.querySelector<HTMLDialogElement>("[data-reel-viewer]");
		const openButton = section.querySelector<HTMLButtonElement>("[data-reel-open]");
		const closeButton = section.querySelector<HTMLButtonElement>("[data-reel-close]");
		const track = section.querySelector<HTMLElement>("[data-reel-track]");
		if (!viewer || !openButton || !closeButton || !track) return;

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const items = Array.from(track.querySelectorAll<HTMLElement>("[data-reel-item]"));
		const frames = items.filter((el) => el.classList.contains("frame"));
		const extras = items.filter((el) => !frames.includes(el)); // the closing card
		const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-stack-card]"));
		// the strip's text and buttons around the photos
		const chrome = Array.from(viewer.querySelectorAll<HTMLElement>(".viewer__head, .viewer__foot, .viewer__close, .viewer__ghost"));
		const captions = frames.map((el) => el.querySelector<HTMLElement>(".frame__cap"));
		const count = viewer.querySelector<HTMLElement>("[data-reel-count]");
		const bar = viewer.querySelector<HTMLElement>("[data-reel-bar]");
		const last = items.length - 1;

		let centers: number[] = [];
		let viewWidth = 0;
		let position = 0; // where the strip is, in items (fractional mid-move)
		let index = 0; // the item it rests on, or is heading to
		let moving = false;
		// closed, then opening (prints flying out), open, closing (flying back)
		let phase: "closed" | "opening" | "open" | "closing" = "closed";
		let flight: Animation[] = []; // the opening, kept to run it backwards
		let flyers: HTMLElement[] = [];
		let shown = -1;
		let locked = -1;
		let stepFrame = 0;
		let lastWheel = 0;
		let gestureUsed = false;
		let touchX = 0;
		let touchY = 0;
		let cursorHome: Node = document.body;

		const measure = () => {
			viewWidth = viewer.clientWidth;
			centers = items.map((el) => el.offsetLeft + el.offsetWidth / 2);
		};

		// Draw the strip with item position `p` (fractional) under the centre of the screen.
		const paint = (p: number) => {
			const i = Math.min(last - 1, Math.floor(p));
			const at = centers[i] + (centers[i + 1] - centers[i]) * (p - i);
			track.style.transform = `translate3d(${(viewWidth / 2 - at).toFixed(1)}px, 0, 0)`;
			viewer.style.setProperty("--progress", (p / last).toFixed(4));
			if (bar) bar.style.transform = `scaleX(${(p / last).toFixed(4)})`;
			let closest = 0;
			items.forEach((el, k) => {
				// -1 at the left edge of the screen, 0 at the centre, 1 at the right edge
				const offset = (centers[k] - at) / (viewWidth / 2);
				el.style.setProperty("--focus", Math.max(0, 1 - Math.abs(offset) * 1.6).toFixed(3));
				el.style.setProperty("--shift", clamp(offset, -1, 1).toFixed(3));
				if (Math.abs(centers[k] - at) < Math.abs(centers[closest] - at)) closest = k;
			});
			if (closest !== shown) {
				shown = closest;
				// photos up to and including the one in focus; the closing card
				// after the last photo reads as that last photo
				const number = items.slice(0, closest + 1).filter((el) => frames.includes(el)).length;
				if (count) count.textContent = `${pad(Math.max(1, number))} / ${pad(frames.length)}`;
			}
		};

		const flash = (item: HTMLElement) => {
			if (reduced || !frames.includes(item)) return;
			frames.forEach((el) => el.classList.remove("is-flash"));
			void item.offsetWidth;
			item.classList.add("is-flash");
		};

		// A move came to rest on item k: focus locks on with a flash.
		const lockOn = (k: number) => {
			if (k === locked) return;
			locked = k;
			flash(items[k]);
		};

		// one full move to item k; past either end closes the viewer
		const go = (k: number) => {
			if (phase !== "open") return;
			if (k < 0 || k > last) {
				close();
				return;
			}
			const from = position;
			const start = performance.now();
			const duration = reduced ? 0 : STEP_SECONDS * 1000;
			index = k;
			moving = true;
			cancelAnimationFrame(stepFrame);
			const step = (now: number) => {
				const t = duration ? clamp((now - start) / duration, 0, 1) : 1;
				position = from + (k - from) * easeInOut(t);
				paint(position);
				if (t < 1) {
					stepFrame = requestAnimationFrame(step);
				} else {
					moving = false;
					lockOn(k);
				}
			};
			stepFrame = requestAnimationFrame(step);
		};

		// photo i as a print in the row
		const inRow = (i: number): Pose => {
			const img = cards[i].querySelector("img");
			const style = getComputedStyle(cards[i]);
			return {
				rect: cards[i].getBoundingClientRect(),
				opacity: img ? getComputedStyle(img).opacity : "1",
				transform: "none",
				shadow: style.boxShadow,
				edge: style.outlineColor,
			};
		};

		// photo i where it sits in the strip (the transform is .frame__img's own)
		const inStrip = (i: number): Pose => {
			const media = frames[i].querySelector<HTMLElement>(".frame__media") ?? frames[i];
			const img = media.querySelector("img");
			const shift = parseFloat(frames[i].style.getPropertyValue("--shift")) || 0;
			return {
				rect: media.getBoundingClientRect(),
				opacity: img ? getComputedStyle(img).opacity : "1",
				transform: `translate3d(${(shift * -4).toFixed(3)}%, 0, 0) scale(1.08)`,
				shadow: "none",
				edge: "rgba(244, 241, 236, 0)",
			};
		};

		// Carry every photo from one pose to the other. Stand-ins do the flying,
		// above everything in the dialog, while the real prints and strip photos
		// stay hidden; the first photo stays on top all the way, as in the row.
		const fly = (from: Pose[], to: Pose[], duration: number, delay: (i: number) => number, landed?: (i: number) => void) =>
			from.flatMap((start, i) => {
				const end = to[i];
				const source = cards[i].querySelector("img");
				const flyer = document.createElement("div");
				flyer.className = "reel-flyer";
				flyer.style.zIndex = String(10 + from.length - i);
				const img = document.createElement("img");
				img.alt = "";
				img.decoding = "sync";
				img.src = source?.currentSrc || source?.src || "";
				flyer.append(img);
				viewer.append(flyer);
				flyers[i] = flyer;
				const timing: KeyframeAnimationOptions = { duration, delay: delay(i), easing: flyEasing, fill: "both" };
				const box = ({ rect, shadow, edge }: Pose) => ({
					left: `${rect.left}px`,
					top: `${rect.top}px`,
					width: `${rect.width}px`,
					height: `${rect.height}px`,
					boxShadow: shadow,
					outlineColor: edge,
				});
				const trip = flyer.animate([box(start), box(end)], timing);
				if (landed) trip.finished.then(() => landed(i), () => {});
				return [trip, img.animate([{ opacity: start.opacity, transform: start.transform }, { opacity: end.opacity, transform: end.transform }], timing)];
			});

		const removeFlyers = () => {
			flyers.forEach((el) => el.remove());
			flyers = [];
		};

		const lockPage = (locked: boolean) => {
			document.documentElement.classList.toggle("reel-open", locked);
			const lenis = getLenis();
			if (locked) lenis?.stop();
			else lenis?.start();
			// the custom cursor lives in <body>, below the dialog's top layer
			const cursor = document.getElementById("cursor");
			if (locked && cursor?.parentNode && cursor.parentNode !== viewer) {
				cursorHome = cursor.parentNode;
				viewer.append(cursor);
			} else if (!locked && cursor?.parentNode === viewer) {
				cursorHome.appendChild(cursor);
			}
		};

		// the strip, on its first photo
		const show = () => {
			lockPage(true);
			viewer.showModal();
			// focus the strip itself rather than the X, or the first arrow key
			// lights the X up as if it were about to be pressed
			viewer.focus({ preventScroll: true });
			measure();
			position = 0;
			index = 0;
			shown = -1;
			locked = 0; // the first photo is already in focus
			paint(0);
		};

		// photo i has arrived: the real one takes over from its stand-in
		const land = (i: number) => {
			if (phase !== "opening") return;
			frames[i].classList.remove("is-away");
			flyers[i]?.remove();
			if (i === 0) flash(frames[0]);
			if (frames.every((el) => !el.classList.contains("is-away"))) phase = "open";
		};

		const open = () => {
			if (phase !== "closed") return;
			phase = "opening";
			if (reduced) {
				show();
				phase = "open";
				return;
			}
			// the button gets out of the way, then the prints take off
			openButton.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, fill: "forwards" }).finished.then(() => {
				if (phase !== "opening") return;
				// hold the row as it is (spread or not) until it's back, so the
				// photos land exactly where they took off from
				cards.forEach((card) => (card.style.transform = getComputedStyle(card).transform));
				const from = cards.map((_, i) => inRow(i));
				show();
				const to = frames.map((_, i) => inStrip(i));
				frames.forEach((el) => el.classList.add("is-away"));
				cards.forEach((card) => (card.style.visibility = "hidden"));
				const delay = (i: number) => i * FLY_STAGGER_MS;
				flight = [
					...fly(from, to, FLY_IN_MS, delay, land),
					// The page goes dark first. The strip's text waits for the dark,
					// so it never shows on top of the site header underneath.
					viewer.animate([{ backgroundColor: "rgba(10, 9, 8, 0)" }, { backgroundColor: "rgba(10, 9, 8, 1)" }], {
						duration: FADE_MS,
						easing: "ease-out",
						fill: "backwards",
					}),
					...chrome.map((el) =>
						el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 350, delay: FADE_MS, easing: "ease-out", fill: "backwards" })
					),
					// each caption comes in as its photo lands
					...captions.flatMap((cap, i) =>
						cap
							? [
									cap.animate([{ opacity: 0 }, { opacity: getComputedStyle(cap).opacity }], {
										duration: 300,
										delay: FLY_IN_MS + delay(i),
										fill: "backwards",
									}),
								]
							: []
					),
				];
			}, () => {});
		};

		// put everything back the way it was before open()
		const reset = () => {
			cancelAnimationFrame(stepFrame);
			moving = false;
			phase = "closed";
			flight = [];
			viewer.getAnimations({ subtree: true }).forEach((a) => a.cancel());
			removeFlyers();
			frames.forEach((el) => el.classList.remove("is-away"));
			cards.forEach((card) => {
				card.style.visibility = "";
				card.style.transform = "";
			});
			lockPage(false);
			// the button comes back once the prints are down
			openButton.getAnimations().forEach((a) => a.cancel());
			if (!reduced) openButton.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: "ease-out" });
		};

		// close the dialog and reset in one go, so no frame shows the page
		// without its prints
		const shut = () => {
			if (viewer.open) viewer.close();
			reset();
		};

		const close = () => {
			if (phase === "closed" || phase === "closing") return;
			if (phase === "opening") {
				// changed their mind mid-flight: the opening plays backwards
				phase = "closing";
				if (!flight.length) {
					shut();
					return;
				}
				flight.forEach((a) => a.reverse());
				Promise.all(flight.map((a) => a.finished)).then(shut, () => {});
				return;
			}
			phase = "closing";
			cancelAnimationFrame(stepFrame);
			moving = false;
			if (reduced) {
				shut();
				return;
			}
			// the photos slide back into the row, the first one landing last, on top
			const from = frames.map((_, i) => inStrip(i));
			const to = cards.map((_, i) => inRow(i));
			frames.forEach((el) => el.classList.add("is-away"));
			const trip = fly(from, to, FLY_OUT_MS, (i) => (frames.length - 1 - i) * FLY_STAGGER_MS);
			// same the other way round: the text goes first, then the dark lifts
			[...chrome, ...extras, ...captions].forEach((el) => {
				if (el) el.animate([{ opacity: getComputedStyle(el).opacity }, { opacity: 0 }], { duration: 200, fill: "forwards" });
			});
			const fade = viewer.animate([{ backgroundColor: "rgba(10, 9, 8, 1)" }, { backgroundColor: "rgba(10, 9, 8, 0)" }], {
				duration: FLY_OUT_MS,
				delay: 200,
				easing: "ease-in",
				fill: "forwards",
			});
			Promise.all([...trip, fade].map((a) => a.finished)).then(shut, () => {});
		};

		const cleanups: Array<() => void> = [];
		const on = (target: EventTarget, type: string, fn: (e: any) => void, options?: AddEventListenerOptions) => {
			target.addEventListener(type, fn, options);
			cleanups.push(() => target.removeEventListener(type, fn, options));
		};

		on(openButton, "click", open);
		on(closeButton, "click", close);
		// Esc: run the slide back first, then close
		on(viewer, "cancel", (e: Event) => {
			e.preventDefault();
			close();
		});
		// however it closed, undo everything
		on(viewer, "close", () => {
			if (phase !== "closed") reset();
		});

		// One wheel or trackpad gesture = one photo. Events that belong to a
		// gesture already used (trackpad momentum) or that arrive mid-move are swallowed.
		on(
			viewer,
			"wheel",
			(e: WheelEvent) => {
				if (e.ctrlKey) return; // pinch zoom
				e.preventDefault();
				const now = performance.now();
				// a gesture that starts while a photo is moving is ignored as a whole
				if (now - lastWheel > GESTURE_GAP) gestureUsed = moving || phase !== "open";
				lastWheel = now;
				const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
				if (!delta || moving || gestureUsed || phase !== "open") return;
				gestureUsed = true;
				go(index + (delta > 0 ? 1 : -1));
			},
			{ passive: false }
		);

		on(viewer, "keydown", (e: KeyboardEvent) => {
			if (e.altKey || e.ctrlKey || e.metaKey) return;
			const target = e.target as HTMLElement | null;
			const forward = ["ArrowRight", "ArrowDown", "PageDown"].includes(e.key) || (e.key === " " && !e.shiftKey);
			const back = ["ArrowLeft", "ArrowUp", "PageUp"].includes(e.key) || (e.key === " " && e.shiftKey);
			if (!forward && !back) return;
			if (e.key === " " && target?.closest("button")) return; // space presses buttons
			e.preventDefault();
			if (!moving) go(index + (forward ? 1 : -1));
		});

		// swipes, in either direction, on touch screens
		on(
			viewer,
			"touchstart",
			(e: TouchEvent) => {
				touchX = e.touches[0].clientX;
				touchY = e.touches[0].clientY;
			},
			{ passive: true }
		);
		on(viewer, "touchmove", (e: TouchEvent) => e.preventDefault(), { passive: false });
		on(viewer, "touchend", (e: TouchEvent) => {
			const t = e.changedTouches[0];
			const dx = t.clientX - touchX;
			const dy = t.clientY - touchY;
			if (Math.max(Math.abs(dx), Math.abs(dy)) < SWIPE_MIN || moving) return;
			const forward = Math.abs(dx) > Math.abs(dy) ? dx < 0 : dy < 0;
			go(index + (forward ? 1 : -1));
		});

		// tabbing to a photo brings it into focus
		on(track, "focusin", (e: FocusEvent) => {
			const item = (e.target as HTMLElement).closest<HTMLElement>("[data-reel-item]");
			const k = item ? items.indexOf(item) : -1;
			if (k !== -1 && k !== index && !moving) go(k);
		});

		on(
			window,
			"resize",
			() => {
				if (phase !== "open") return;
				measure();
				paint(position);
			},
			{ passive: true }
		);

		// fetch the strip's photos once the section comes near, so they're there on open
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				viewer.querySelectorAll("img").forEach((img) => (img.loading = "eager"));
				io.disconnect();
			},
			{ rootMargin: "100% 0px" }
		);
		io.observe(section);

		on(
			document,
			"astro:before-swap",
			() => {
				if (phase !== "closed") reset();
				io.disconnect();
				cleanups.forEach((fn) => fn());
			},
			{ once: true }
		);
	}

	const bindReels = () => document.querySelectorAll<HTMLElement>("[data-reel]").forEach(bindReel);
	bindReels();
	document.addEventListener("astro:after-swap", bindReels);
</script>

<style>
	/* ======== in the page: the row of prints ======== */
	.reel {
		position: relative;
		overflow: hidden;
		padding: var(--space-6) 0 var(--space-4);
		background: var(--ink);
		color: var(--bone);
	}

	.reel__head,
	.reel__foot,
	.viewer__head,
	.viewer__foot {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-inline: var(--gutter);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
	}

	.reel__kicker,
	.viewer__kicker {
		margin: 0;
		font-size: inherit;
		font-weight: 400;
		letter-spacing: inherit;
	}

	.reel__meta {
		display: flex;
		gap: var(--space-3);
		margin: 0;
		opacity: 0.6;
	}

	/* the collection name, huge and outlined, behind everything */
	.reel__ghost,
	.viewer__ghost {
		position: absolute;
		left: var(--gutter);
		bottom: var(--space-4);
		z-index: 0;
		margin: 0;
		font-size: clamp(9rem, 34vw, 38rem);
		line-height: 0.8;
		letter-spacing: 0.02em;
		white-space: nowrap;
		color: transparent;
		-webkit-text-stroke: 1px rgba(244, 241, 236, 0.16);
		pointer-events: none;
		user-select: none;
	}

	.reel__stack {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		height: clamp(400px, 58svh, 620px);
	}

	/* The prints in strip order, left to right. Each one starts --step of a
	   print along from the one before and is tucked under it. */
	.stack {
		--step: 0.4;
		--spread: 1;
		--card-w: min(17vw, 260px, calc((100vw - 2 * var(--gutter)) / (1 + (var(--n) - 1) * var(--step))));
		position: relative;
		width: var(--card-w);
		aspect-ratio: 4 / 5;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack__card {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: var(--ink);
		/* a thin edge so each print reads on its own, even on a dark photo,
		   and a shadow thrown onto the print under it */
		outline: 1px solid rgba(244, 241, 236, 0.24);
		outline-offset: -1px;
		box-shadow:
			18px 0 28px rgba(0, 0, 0, 0.92),
			0 26px 50px rgba(0, 0, 0, 0.5);
		transform: translateX(calc((var(--i) - (var(--n) - 1) / 2) * var(--step) * var(--spread) * var(--card-w)));
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	/* the row opens up a little while the mouse is on it */
	@media (hover: hover) {
		.reel__stack:hover .stack {
			--spread: 1.15;
		}
	}

	.stack__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 28%;
		/* prints further down the row sit deeper in the dark */
		opacity: calc(1 - var(--i) * 0.07);
		-webkit-user-drag: none;
	}

	.reel__open {
		position: absolute;
		z-index: 10;
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		max-width: calc(100vw - 2 * var(--gutter));
		padding: 1.2rem 2.2rem;
		overflow: hidden;
		font-family: var(--font-display);
		font-size: clamp(0.62rem, 2.6vw, 0.85rem);
		letter-spacing: 0.32em;
		text-align: center;
		background: var(--bone);
		color: var(--ink);
		border: 1px solid var(--bone);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
		transition: background 0.4s ease;
	}

	.reel__open::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		background: var(--acid);
		transform: translateY(101%);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.reel__open > * {
		position: relative;
		z-index: 1;
	}

	.reel__open:hover::before,
	.reel__open:focus-visible::before {
		transform: translateY(0);
	}

	.reel__foot {
		margin-top: var(--space-2);
		opacity: 0.85;
	}

	.reel__all {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: color 0.25s ease;
	}

	.reel__all:hover {
		color: var(--acid);
	}

	:global(html.reel-open) {
		overflow: hidden;
	}

	/* ======== opened: the full-screen strip ======== */
	.viewer {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: var(--space-3) 0;
		border: 0;
		overflow: hidden;
		background: var(--ink);
		color: var(--bone);
	}

	.viewer[open] {
		display: grid;
		/* minmax(0, …) keeps the column screen-wide; the strip inside is far wider */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
	}

	.viewer::backdrop {
		background: transparent;
	}

	/* the strip takes focus when it opens; a ring around the whole screen says nothing */
	.viewer:focus {
		outline: none;
	}

	/* the stand-ins that carry the photos between the row and the strip */
	.viewer :global(.reel-flyer) {
		position: fixed;
		overflow: hidden;
		background: var(--ink);
		outline: 1px solid transparent;
		outline-offset: -1px;
		pointer-events: none;
	}

	.viewer :global(.reel-flyer > img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 28%;
	}

	.viewer__ghost {
		transform: translate3d(calc(var(--progress, 0) * -45vw), 0, 0);
	}

	.viewer__close {
		position: absolute;
		top: 50%;
		left: clamp(0.75rem, 1.4vw, 1.5rem);
		z-index: 3;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid rgba(244, 241, 236, 0.35);
		background: rgba(10, 9, 8, 0.6);
		color: var(--bone);
		transform: translateY(-50%);
		transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
	}

	.viewer__close:hover,
	.viewer__close:focus-visible {
		background: var(--acid);
		border-color: var(--acid);
		color: var(--ink);
	}

	.viewer__stage {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		min-height: 0;
	}

	.viewer__track {
		/* photo height, but never wider than --frame-max so a whole photo always
		   fits on screen (landscape shots get shorter instead of cropped) */
		--h: min(62dvh, 680px);
		--frame-max: 80vw;
		--gap: clamp(1.25rem, 3vw, 3rem);
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
		will-change: transform;
	}

	.viewer__item {
		--fh: min(var(--h), calc(var(--frame-max) / var(--ar)));
		flex: 0 0 auto;
		width: calc(var(--fh) * var(--ar));
		transform: scale(calc(0.9 + 0.1 * var(--focus, 1)));
	}

	/* ---- a photo ---- */
	.frame__link {
		display: block;
		color: inherit;
	}

	.frame__media {
		position: relative;
		display: block;
		height: var(--fh);
		overflow: hidden;
		background: var(--ink);
	}

	/* its stand-in is still on the way */
	.frame.is-away .frame__media {
		visibility: hidden;
	}

	/* Out-of-focus photos sink back into the dark. The photo itself fades
	   toward the black behind it rather than getting a dark layer on top: at
	   fractional display scaling (e.g. 125%) a separate layer and the photo get
	   rounded differently, leaving a bright 1px line along the photo's edge. */
	.frame__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: calc(1 - 0.62 * (1 - var(--focus, 1)));
		transform: translate3d(calc(var(--shift, 0) * -4%), 0, 0) scale(1.08);
		-webkit-user-drag: none;
	}

	/* autofocus brackets, locking on as the photo reaches the centre */
	.frame__media::after {
		--c: var(--acid);
		--l: clamp(14px, 2vw, 26px);
		--t: 2px;
		content: "";
		position: absolute;
		inset: clamp(8px, 1.2vw, 16px);
		z-index: 2;
		background:
			linear-gradient(var(--c) 0 0) top left / var(--l) var(--t),
			linear-gradient(var(--c) 0 0) top left / var(--t) var(--l),
			linear-gradient(var(--c) 0 0) top right / var(--l) var(--t),
			linear-gradient(var(--c) 0 0) top right / var(--t) var(--l),
			linear-gradient(var(--c) 0 0) bottom left / var(--l) var(--t),
			linear-gradient(var(--c) 0 0) bottom left / var(--t) var(--l),
			linear-gradient(var(--c) 0 0) bottom right / var(--l) var(--t),
			linear-gradient(var(--c) 0 0) bottom right / var(--t) var(--l);
		background-repeat: no-repeat;
		opacity: clamp(0, (var(--focus, 0) - 0.7) * 4, 1);
		transform: scale(calc(1.08 - 0.08 * var(--focus, 0)));
		pointer-events: none;
	}

	.frame__flash {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: var(--bone);
		opacity: 0;
		pointer-events: none;
	}

	.frame.is-flash .frame__flash {
		animation: frame-flash 0.45s ease-out;
	}

	@keyframes frame-flash {
		from {
			opacity: 0.22;
		}
		to {
			opacity: 0;
		}
	}

	.frame__cap {
		display: flex;
		gap: 0.8rem;
		margin-top: 0.8rem;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		opacity: calc(0.3 + 0.7 * var(--focus, 1));
	}

	.frame__no {
		color: var(--acid);
	}

	/* ---- closing card ---- */
	.viewer__end {
		--ar: 0.8;
		height: var(--fh);
	}

	.end__link {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		padding: clamp(1rem, 2.5vw, 2rem);
		border: 1px solid rgba(244, 241, 236, 0.3);
		color: var(--bone);
		transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
	}

	.end__link:hover,
	.end__link:focus-visible {
		background: var(--acid);
		border-color: var(--acid);
		color: var(--ink);
	}

	.end__label {
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		opacity: 0.7;
	}

	.end__title {
		font-size: clamp(1.6rem, 3.4vw, 3.2rem);
		line-height: 1.05;
		letter-spacing: 0.06em;
	}

	.end__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.62rem;
		letter-spacing: 0.2em;
	}

	/* ---- footer: counter, progress, link ---- */
	.viewer__count {
		min-width: 6ch;
	}

	.viewer__progress {
		flex: 1;
		height: 1px;
		background: rgba(244, 241, 236, 0.18);
		overflow: hidden;
	}

	.viewer__progress > span {
		display: block;
		height: 100%;
		background: var(--acid);
		transform: scaleX(0);
		transform-origin: left;
	}

	@media (max-width: 720px) {
		.reel__meta span:first-child {
			display: none;
		}
		.reel__stack {
			height: clamp(280px, 36svh, 380px);
		}
		/* tighter, so the whole row still fits across a phone */
		.stack {
			--step: 0.26;
			--card-w: min(200px, calc((100vw - 2 * var(--gutter)) / (1 + (var(--n) - 1) * var(--step))));
		}
		.stack__card {
			box-shadow:
				10px 0 16px rgba(0, 0, 0, 0.9),
				0 16px 32px rgba(0, 0, 0, 0.5);
		}
		.reel__open {
			padding: 1rem 1.3rem;
			letter-spacing: 0.22em;
		}
		.viewer__track {
			--h: 56dvh;
			/* narrow enough that the photos either side peek in */
			--frame-max: 76vw;
		}
		/* the photos take up the whole width here, so the X moves up next to the title */
		.viewer__close {
			top: var(--space-3);
			left: var(--gutter);
			width: 36px;
			height: 36px;
			transform: none;
		}
		.viewer__head {
			min-height: 36px;
			padding-left: calc(var(--gutter) + 36px + var(--space-2));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stack__card,
		.reel__open::before {
			transition: none;
		}
		.frame.is-flash .frame__flash {
			animation: none;
		}
	}
</style>
