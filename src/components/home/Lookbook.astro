---
import { Image } from "astro:assets";
import { objectLabel, PHOTO_WIDTHS } from "../../consts";
import { getHomePagePhoto, collectionOf } from "../../lib/hoodies";

// Photos from the NDSM shoot, as "<object number>/<file name>". `focus` moves
// the crop's vertical focal point (default: 28% from the top).
const layouts = [
	{ photo: "2/_DSC9903.jpg", layout: "full" },
	{ photo: "20/_DSC9601.jpg", layout: "left" },
	{ photo: "14/BadJujuShoot-15.jpg", layout: "right" },
	{ photo: "17/BadJujuShoot-26.jpg", layout: "full", focus: "12%" },
];

const looks = layouts.map(({ photo, layout, focus }) => {
	const { hoodie, image } = getHomePagePhoto(photo);
	return {
		image,
		style: focus ? `object-position: center ${focus}` : undefined,
		href: `/portfolio/${hoodie.id}`,
		caption: objectLabel(hoodie.number),
		caption2: [collectionOf(hoodie)?.name, hoodie.status.toUpperCase(), hoodie.completed]
			.filter(Boolean)
			.join(" · "),
		// full-width looks span the page, the side-by-side ones take two thirds
		sizes: layout === "full" ? "(max-width: 1680px) 100vw, 1680px" : "(max-width: 800px) 100vw, 66vw",
		layout,
	};
});
---

<section class="lookbook" id="lookbook">
	<header class="lookbook__head">
		<p class="mono kicker" data-reveal>// V. LOOKBOOK</p>
		<h2 class="display title" data-reveal>WORN · IN · THE · WILD</h2>
	</header>

	<div class="lookbook__stack">
		{
			looks.map((look, i) => (
				<figure
					class:list={["look", `look--${look.layout}`]}
					data-reveal
					style={`--i: ${i}`}
				>
					<a class="look__img-wrap" href={look.href} data-cursor="zoom" data-cursor-label="VIEW">
						<Image
							class="look__img"
							src={look.image}
							alt={look.caption}
							widths={PHOTO_WIDTHS}
							sizes={look.sizes}
							style={look.style}
						/>
					</a>
					<figcaption class="look__cap mono">
						<span class="look__no">/// {String(i + 1).padStart(2, "0")}</span>
						<a class="look__name" href={look.href} data-cursor="link">{look.caption}</a>
						<span class="look__sub">{look.caption2}</span>
					</figcaption>
				</figure>
			))
		}
	</div>
</section>

<style>
	.lookbook {
		background: var(--bone);
		color: var(--ink);
		padding: var(--space-7) var(--gutter);
	}

	.lookbook__head {
		max-width: var(--max-w);
		margin: 0 auto var(--space-6);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.kicker {
		opacity: 0.5;
		font-size: 0.7rem;
		margin: 0;
	}

	.title {
		margin: 0;
		font-size: clamp(2rem, 5.5vw, 4.5rem);
		letter-spacing: 0.1em;
	}

	.lookbook__stack {
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
		max-width: var(--max-w);
		margin: 0 auto;
	}

	.look {
		margin: 0;
		display: grid;
		gap: var(--space-3);
	}

	.look--full {
		grid-template-columns: 1fr;
	}

	.look--left {
		grid-template-columns: 2fr 1fr;
		align-items: end;
	}

	.look--right {
		grid-template-columns: 1fr 2fr;
		align-items: start;
	}

	.look--right .look__cap {
		order: -1;
	}

	.look__img-wrap {
		display: block;
		overflow: hidden;
		background: var(--chrome-1);
		aspect-ratio: 4 / 5;
		clip-path: inset(8% 8% 8% 8%);
		transition: clip-path 1.4s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.look--full .look__img-wrap {
		aspect-ratio: 21 / 9;
	}

	[data-reveal].is-revealed .look__img-wrap {
		clip-path: inset(0% 0% 0% 0%);
	}

	.look__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 28%;
		filter: saturate(0.96);
		transform: scale(1.04);
		transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	[data-reveal].is-revealed .look__img {
		transform: scale(1);
	}

	.look__cap {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: var(--space-2) 0;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
	}

	.look__no {
		opacity: 0.5;
	}

	.look__name {
		font-family: var(--font-display);
		font-size: clamp(0.95rem, 1.4vw, 1.4rem);
		letter-spacing: 0.18em;
	}

	.look__sub {
		opacity: 0.55;
		font-size: 0.65rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.look__img-wrap,
		.look__img {
			transition: none;
			clip-path: inset(0);
			transform: none;
		}
	}

	@media (max-width: 800px) {
		.look--left,
		.look--right {
			grid-template-columns: 1fr;
		}
		.look--right .look__cap {
			order: 0;
		}
	}
</style>
