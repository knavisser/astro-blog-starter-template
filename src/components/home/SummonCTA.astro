---
import Icon from "../Icon.astro";
import BadJujuLogo from "../BadJujuLogo.astro";
---

<section class="summon" id="summon-cta">
	<div class="summon__bg" aria-hidden="true"></div>
	<div class="summon__scrim" aria-hidden="true"></div>

	<div class="summon__inner">
		<span class="summon__logo" aria-hidden="true">
			<BadJujuLogo mode="solid" class="summon__logo-fill" />
			<BadJujuLogo mode="solid" class="summon__logo-border" />
		</span>

		<div class="summon__body" data-reveal>
			<p class="mono kicker">// III. SUMMON</p>

			<h2 class="display">
				<span class="row">SUMMON</span>
				<span class="row row--right"><em>your</em></span>
				<span class="row">OWN.</span>
			</h2>

			<p class="lede">
				Every piece starts with a conversation. Tell us the style you wish to
				portray, the colours of your soul, and the animal you want to be. We'll
				take it from there.
			</p>

			<a class="cta" href="/custom" data-cursor="link">
				<span>REQUEST A PIECE</span>
				<Icon name="arrow-up-right" size={20} />
			</a>

			<p class="mono fineprint">
				MTO LEAD TIME 3-6 WEEKS · LIMITED CYCLES · BUILT IN THE LOWLANDS
			</p>
		</div>
	</div>
</section>

<style>
	.summon {
		background: var(--ink);
		color: var(--bone);
		padding: var(--space-8) var(--gutter);
		position: relative;
		overflow: hidden;
	}

	/* moving marble, nudged toward our acid green and darkened a touch. Kept as a
	   dedicated layer (not ::after) so it paints behind the content and the logo
	   can blend with it. */
	.summon__bg {
		position: absolute;
		top: -25%;
		left: -25%;
		width: 150%;
		height: 150%;
		pointer-events: none;
		background:
			linear-gradient(rgba(198, 255, 0, 0.1), rgba(198, 255, 0, 0.1)),
			url("/png/map_bg.jpg") center / cover no-repeat;
		filter: brightness(0.8) saturate(1.25);
		animation: summon-drift 90s ease-in-out infinite alternate;
		will-change: transform;
	}

	@keyframes summon-drift {
		from {
			transform: translate3d(-10%, -10%, 0);
		}
		to {
			transform: translate3d(10%, 10%, 0);
		}
	}

	/* readability scrim: a soft pool of ink behind the centred text, fading to
	   zero at the section edges so no boundary is visible over the marble */
	.summon__scrim {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			ellipse 50% 58% at 50% 50%,
			rgba(10, 9, 8, 0.6) 0%,
			rgba(10, 9, 8, 0.5) 42%,
			rgba(10, 9, 8, 0.28) 70%,
			transparent 100%
		);
	}

	/* No z-index here: keeping .summon__inner out of its own stacking context
	   lets the logo's blend mode reach the marble layer behind it. It still
	   paints above the bg/scrim because it comes later in the DOM. */
	.summon__inner {
		position: relative;
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-3);
	}

	/* same treatment as the hero logo so the two read identically: a softened
	   exclusion-blend fill (legible over the moving marble) plus a thin,
	   non-blended white outline stacked on top. No z-index here keeps the fill's
	   blend reaching the marble layer behind it. */
	.summon__logo {
		position: relative;
		display: block;
		width: 88px;
	}

	.summon__logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.summon__logo :global(.summon__logo-fill) {
		color: #cccccc;
		mix-blend-mode: exclusion;
	}

	.summon__logo :global(.summon__logo-border) {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		pointer-events: none;
		filter: drop-shadow(0 0 1px #ffffff)
			drop-shadow(0 0 4px rgba(255, 255, 255, 0.6));
	}

	.summon__logo :global(.summon__logo-border path) {
		fill: none;
		stroke: #ffffff;
		stroke-width: 1.5;
		vector-effect: non-scaling-stroke;
	}

	.summon__body {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-3);
	}

	.kicker {
		opacity: 0.6;
		font-size: 0.7rem;
		margin: 0;
	}

	h2 {
		margin: var(--space-2) 0;
		display: flex;
		flex-direction: column;
		gap: 0.05em;
		line-height: 0.92;
	}

	.row {
		font-size: clamp(2.8rem, 12vw, 10rem);
		letter-spacing: 0.06em;
	}

	.row--right {
		align-self: end;
	}

	.row em {
		font-family: var(--font-body);
		font-style: italic;
		font-weight: 300;
		font-size: 0.55em;
		opacity: 0.65;
		text-transform: lowercase;
		padding: 0 0.3em;
		vertical-align: 0.2em;
	}

	.lede {
		font-size: 1rem;
		line-height: 1.6;
		max-width: 56ch;
		margin: var(--space-3) auto 0;
		opacity: 0.78;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: var(--space-3);
		padding: 1.2rem 2.2rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.32em;
		background: var(--bone);
		color: var(--ink);
		border: 1px solid var(--bone);
		position: relative;
		overflow: hidden;
		transition: color 0.4s ease, background 0.4s ease;
	}

	.cta::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--acid);
		transform: translateY(101%);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
		z-index: 0;
	}

	.cta > * {
		position: relative;
		z-index: 1;
	}

	.cta:hover::before {
		transform: translateY(0);
	}

	.cta:hover {
		background: var(--acid);
	}

	.fineprint {
		opacity: 0.75;
		font-size: 0.62rem;
		margin: 0;
		margin-top: var(--space-3);
	}

	@media (prefers-reduced-motion: reduce) {
		.summon__bg {
			animation: none;
		}
	}

	@media (max-width: 720px) {
		.row--right {
			align-self: center;
		}
	}
</style>
