---
import CrossCircle from "../sigils/CrossCircle.astro";
import Icon from "../Icon.astro";
---

<section class="summon" id="summon-cta">
	<div class="summon__inner" data-reveal>
		<CrossCircle size={64} class="summon__sigil" animated />
		<p class="mono kicker">// IV. SUMMON</p>

		<h2 class="display">
			<span class="row">SUMMON</span>
			<span class="row row--right"><em>your</em></span>
			<span class="row">OWN.</span>
		</h2>

		<p class="lede">
			Every piece starts with a conversation. Tell us the style you wish to
			portray, the colours of your soul, and the animal you want to be. We'll
			take it from there.
		</p>

		<a class="cta" href="/custom" data-cursor="link">
			<span>REQUEST A PIECE</span>
			<Icon name="arrow-up-right" size={20} />
		</a>

		<p class="mono fineprint">
			MTO LEAD TIME 3-6 WEEKS · LIMITED CYCLES · BUILT IN THE LOWLANDS
		</p>
	</div>
</section>

<style>
	.summon {
		background: var(--ink);
		color: var(--bone);
		padding: var(--space-8) var(--gutter);
		position: relative;
		overflow: hidden;
	}

	.summon::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(60% 50% at 20% 30%, rgba(198, 255, 0, 0.04) 0%, transparent 60%),
			radial-gradient(50% 40% at 80% 70%, rgba(217, 213, 205, 0.06) 0%, transparent 60%);
		pointer-events: none;
	}

	.summon::after {
		content: "";
		position: absolute;
		top: -25%;
		left: -25%;
		width: 150%;
		height: 150%;
		pointer-events: none;
		background-color: var(--acid);
		-webkit-mask: url("/png/map_bg.png") center / cover no-repeat;
		mask: url("/png/map_bg.png") center / cover no-repeat;
		opacity: 0.3;
		animation: summon-drift 90s ease-in-out infinite alternate;
		will-change: transform;
	}

	@keyframes summon-drift {
		from {
			transform: translate3d(-10%, -10%, 0);
		}
		to {
			transform: translate3d(10%, 10%, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.summon::after {
			animation: none;
		}
	}

	.summon__inner {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-3);
	}

	:global(.summon__sigil) {
		color: var(--acid);
	}

	.kicker {
		opacity: 0.6;
		font-size: 0.7rem;
		margin: 0;
	}

	h2 {
		margin: var(--space-2) 0;
		display: flex;
		flex-direction: column;
		gap: 0.05em;
		line-height: 0.92;
	}

	.row {
		font-size: clamp(2.8rem, 12vw, 10rem);
		letter-spacing: 0.06em;
	}

	.row--right {
		align-self: end;
	}

	.row em {
		font-family: var(--font-body);
		font-style: italic;
		font-weight: 300;
		font-size: 0.55em;
		opacity: 0.65;
		text-transform: lowercase;
		padding: 0 0.3em;
		vertical-align: 0.2em;
	}

	.lede {
		font-size: 1rem;
		line-height: 1.6;
		max-width: 56ch;
		margin: 0;
		opacity: 0.78;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: var(--space-3);
		padding: 1.2rem 2.2rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.32em;
		background: var(--bone);
		color: var(--ink);
		border: 1px solid var(--bone);
		position: relative;
		overflow: hidden;
		transition: color 0.4s ease, background 0.4s ease;
	}

	.cta::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--acid);
		transform: translateY(101%);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
		z-index: 0;
	}

	.cta > * {
		position: relative;
		z-index: 1;
	}

	.cta:hover::before {
		transform: translateY(0);
	}

	.cta:hover {
		background: var(--acid);
	}

	.fineprint {
		opacity: 0.75;
		font-size: 0.62rem;
		margin: 0;
		margin-top: var(--space-3);
	}

	@media (max-width: 720px) {
		.row--right {
			align-self: center;
		}
	}
</style>
