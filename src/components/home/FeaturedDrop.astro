---
import { getCollection } from "astro:content";
import Icon from "../Icon.astro";

const pieces = (await getCollection("pieces")).sort(
	(a, b) => a.data.index - b.data.index
);

const total = pieces.length;
// duplicate items for a seamless marquee loop
const loop = [...pieces, ...pieces];
---

<section class="drop" id="drop" data-state="running">
	<div class="drop__head-wrap">
		<header class="drop__head">
			<div class="drop__head-left">
				<p class="mono drop__kicker">// II. CYCLE I</p>
				<h2 class="display drop__title">FEATURED · DROP</h2>
			</div>
			<div class="drop__head-right mono">
				<p>{String(total).padStart(2, "0")} PIECES · INFINITE LOOP</p>
				<p>DRAG TO SCRUB · TAP TO FOCUS ↦</p>
			</div>
		</header>
	</div>

	<div class="drop__rail-wrap" id="drop-wrap">
		<div class="drop__shift" id="drop-shift">
			<ol class="drop__rail" id="drop-rail" style={`--n: ${total};`}>
				{
					loop.map((piece, idx) => (
						<li class="card">
							<button
								class="card__btn"
								type="button"
								data-cursor="zoom"
								data-cursor-label="FOCUS"
								data-piece-id={piece.id}
							>
								<figure class="card__figure">
									<img
										class="card__img"
										src={piece.data.heroImage}
										alt={piece.data.name}
										loading={idx < 3 ? "eager" : "lazy"}
										draggable="false"
									/>
								</figure>
								<div class="card__base">
									<span class="mono card__idx">
										///{String(piece.data.index).padStart(2, "0")} / {String(total).padStart(2, "0")}
									</span>
									<h3 class="display card__name">{piece.data.name}</h3>
									<div class="card__meta mono">
										<span>{piece.data.earStyle.toUpperCase()}</span>
										<span class="dot">·</span>
										<span>{piece.data.status === "available" ? "AVAILABLE" : "MTO"}</span>
									</div>
								</div>
								<div class="card__details">
									<div class="card__details-inner">
										<p class="card__summary">{piece.data.summary}</p>
										<p class="mono card__mat-label">// MATERIALS</p>
										<ul class="card__materials mono">
											{piece.data.materials.map((m: string) => <li>{m}</li>)}
										</ul>
										<a class="card__cta mono" href={`/archive/${piece.id}`} data-cursor="link">
											<span>VIEW PIECE</span>
											<Icon name="arrow-up-right" size={14} />
										</a>
									</div>
								</div>
							</button>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<script>
	function bindDrop() {
		const section = document.querySelector(".drop") as HTMLElement | null;
		const wrap = document.getElementById("drop-wrap");
		const shift = document.getElementById("drop-shift");
		const rail = document.getElementById("drop-rail");
		if (!section || !wrap || !shift || !rail) return;

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const AUTO_VELOCITY = reduced ? 0 : 36; // px / s — idle drift speed
		const DRAG_RATIO_MOUSE = 0.5; // desktop: rail moves half the mouse delta — feels controlled
		const DRAG_RATIO_TOUCH = 1.0; // mobile: rail follows the finger 1:1 — native-feeling swipe
		const INERTIA_DECAY = 0.95; // per frame at 60 fps — lower = snappier stop
		const VELOCITY_CLAMP = 2800; // px / s — momentum cap on a fast flick
		const DRAG_THRESHOLD = 6; // px — movement before a tap becomes a drag

		// measure the width of one "cycle" (first half of the doubled content)
		let cycleWidth = 0;
		const measure = () => {
			cycleWidth = rail.scrollWidth / 2;
		};
		measure();
		window.addEventListener("resize", measure, { passive: true });
		// re-measure once fonts/images finalise layout
		if ((document as any).fonts?.ready) (document as any).fonts.ready.then(measure);
		window.addEventListener("load", measure, { once: true });

		// ---- state ----
		let pos = 0;
		let dragVelocity = 0;
		let isDragging = false;
		let suppressClick = false;
		let activePointerId: number | null = null;
		let pointerStartX = 0;
		let pointerLastX = 0;
		let pointerLastT = 0;
		let pointerStartPos = 0;
		let dragRatio = DRAG_RATIO_MOUSE;

		let expanded: HTMLElement | null = null;

		// ---- render loop ----
		let lastT = 0;
		let rafId = 0;
		const tick = (t: number) => {
			if (!lastT) lastT = t;
			const dt = Math.min(0.05, (t - lastT) / 1000);
			lastT = t;

			if (!expanded) {
				if (isDragging) {
					// pos is set by pointer handler — nothing to add here
				} else {
					// idle: auto-scroll + decaying drag inertia
					pos -= AUTO_VELOCITY * dt;
					pos -= dragVelocity * dt;
					const k = Math.pow(INERTIA_DECAY, dt * 60);
					dragVelocity *= k;
					if (Math.abs(dragVelocity) < 1) dragVelocity = 0;
				}

				// wrap into [-cycleWidth, 0]
				if (cycleWidth > 0) {
					if (pos <= -cycleWidth) pos += cycleWidth;
					if (pos > 0) pos -= cycleWidth;
				}

				rail.style.transform = `translate3d(${pos.toFixed(2)}px, 0, 0)`;
			}
			rafId = requestAnimationFrame(tick);
		};
		rafId = requestAnimationFrame(tick);

		// ---- expansion ----
		const transferShiftIntoPos = () => {
			const styleVal = shift.style.getPropertyValue("--shift");
			const px = parseFloat(styleVal) || 0;
			if (px === 0) return;
			pos += px;
			// snap the shift without a transition so the visual doesn't jump
			shift.style.transition = "none";
			shift.style.setProperty("--shift", "0px");
			// force reflow then restore CSS-defined transition
			void shift.offsetWidth;
			shift.style.transition = "";
		};

		const closeExpansion = (opts: { instant?: boolean } = {}) => {
			if (!expanded) return;
			expanded.classList.remove("is-expanded");
			expanded = null;
			if (opts.instant) {
				transferShiftIntoPos();
			} else {
				shift.style.setProperty("--shift", "0px");
			}
			section.setAttribute("data-state", "running");
		};

		const openExpansion = (card: HTMLElement) => {
			if (expanded === card) return;
			if (expanded) expanded.classList.remove("is-expanded");
			dragVelocity = 0;
			section.setAttribute("data-state", "paused");

			requestAnimationFrame(() => {
				const cardRect = card.getBoundingClientRect();
				const wrapRect = wrap.getBoundingClientRect();
				const cardCenter = cardRect.left + cardRect.width / 2;
				const wrapCenter = wrapRect.left + wrapRect.width / 2;
				const delta = wrapCenter - cardCenter;
				shift.style.setProperty("--shift", `${delta.toFixed(2)}px`);
				card.classList.add("is-expanded");
				expanded = card;
			});
		};

		// ---- pointer handling (document-level move/up so drag survives leaving wrap) ----
		const onPointerMove = (e: PointerEvent) => {
			if (activePointerId !== e.pointerId) return;
			const dx = e.clientX - pointerStartX;
			if (!isDragging && Math.abs(dx) > DRAG_THRESHOLD) {
				isDragging = true;
				wrap.classList.add("is-dragging");
				if (expanded) closeExpansion({ instant: true });
			}
			if (isDragging) {
				pos = pointerStartPos + dx * dragRatio;
				const now = performance.now();
				const dt = (now - pointerLastT) / 1000;
				if (dt > 0) {
					let instantV = (-(e.clientX - pointerLastX) / dt) * dragRatio;
					// EMA smoothing then clamp
					dragVelocity = 0.7 * dragVelocity + 0.3 * instantV;
					if (dragVelocity > VELOCITY_CLAMP) dragVelocity = VELOCITY_CLAMP;
					if (dragVelocity < -VELOCITY_CLAMP) dragVelocity = -VELOCITY_CLAMP;
				}
				pointerLastX = e.clientX;
				pointerLastT = now;
			}
		};

		const onPointerUp = (e: PointerEvent) => {
			if (activePointerId !== e.pointerId) return;
			document.removeEventListener("pointermove", onPointerMove);
			document.removeEventListener("pointerup", onPointerUp);
			document.removeEventListener("pointercancel", onPointerUp);
			activePointerId = null;
			if (isDragging) {
				suppressClick = true;
				wrap.classList.remove("is-dragging");
				isDragging = false;
				// momentum continues automatically in tick()
			}
		};

		wrap.addEventListener("pointerdown", (e) => {
			if (e.pointerType === "mouse" && e.button !== 0) return;
			isDragging = false;
			activePointerId = e.pointerId;
			pointerStartX = e.clientX;
			pointerLastX = e.clientX;
			pointerLastT = performance.now();
			pointerStartPos = pos;
			dragVelocity = 0;
			dragRatio =
				e.pointerType === "mouse" ? DRAG_RATIO_MOUSE : DRAG_RATIO_TOUCH;
			document.addEventListener("pointermove", onPointerMove);
			document.addEventListener("pointerup", onPointerUp);
			document.addEventListener("pointercancel", onPointerUp);
		});

		// suppress browser drag behaviour on images
		wrap.addEventListener("dragstart", (e) => e.preventDefault());

		// ---- click handling on each card ----
		section.querySelectorAll<HTMLElement>(".card").forEach((card) => {
			const btn = card.querySelector<HTMLElement>(".card__btn");
			if (!btn) return;
			btn.addEventListener("click", (e) => {
				if (suppressClick) {
					suppressClick = false;
					e.preventDefault();
					return;
				}
				const target = e.target as HTMLElement;
				// let VIEW PIECE link nav happen
				if (target.closest(".card__cta")) return;
				e.preventDefault();
				if (expanded === card) {
					closeExpansion();
				} else {
					openExpansion(card);
				}
			});
		});

		// reset on scroll-out
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting && expanded) closeExpansion();
				});
			},
			{ threshold: 0.05 }
		);
		io.observe(section);

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && expanded) closeExpansion();
		});

		// teardown on Astro page swap
		document.addEventListener(
			"astro:before-swap",
			() => {
				cancelAnimationFrame(rafId);
				document.removeEventListener("pointermove", onPointerMove);
				document.removeEventListener("pointerup", onPointerUp);
				document.removeEventListener("pointercancel", onPointerUp);
			},
			{ once: true }
		);
	}

	bindDrop();
	document.addEventListener("astro:after-swap", bindDrop);
</script>

<style>
	.drop {
		position: relative;
		background: var(--bone);
		color: var(--ink);
		padding: var(--space-5) 0 var(--space-7);
		overflow: hidden;
	}

	.drop__head-wrap {
		padding-inline: var(--gutter);
	}

	.drop__head {
		display: flex;
		justify-content: space-between;
		align-items: end;
		max-width: var(--max-w);
		margin: 0 auto;
		padding-bottom: var(--space-4);
		gap: var(--space-3);
	}

	.drop__kicker {
		opacity: 0.5;
		margin: 0 0 0.5rem;
		font-size: 0.7rem;
	}

	.drop__title {
		margin: 0;
		font-size: clamp(2rem, 5.5vw, 4.5rem);
		letter-spacing: 0.06em;
	}

	.drop__head-right {
		text-align: right;
		opacity: 0.5;
		font-size: 0.7rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.drop__head-right p {
		margin: 0;
	}

	.drop__rail-wrap {
		position: relative;
		touch-action: pan-y;
		-webkit-user-select: none;
		user-select: none;
		cursor: grab;
		mask-image: linear-gradient(
			to right,
			transparent 0,
			#000 4%,
			#000 96%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0,
			#000 4%,
			#000 96%,
			transparent 100%
		);
	}

	.drop__rail-wrap.is-dragging {
		cursor: grabbing;
	}

	/* outer layer for click-to-center shift */
	.drop__shift {
		--shift: 0px;
		transform: translate3d(var(--shift), 0, 0);
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
		will-change: transform;
	}

	/* inner rail — JS-driven transform */
	.drop__rail {
		--card-w: clamp(280px, 28vw, 360px);
		--card-gap: 1.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		gap: var(--card-gap);
		align-items: flex-start;
		width: max-content;
		will-change: transform;
	}

	/* ---- card ---- */
	.card {
		flex: 0 0 var(--card-w);
		width: var(--card-w);
		transform-origin: center top;
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.card.is-expanded {
		z-index: 5;
		transform: scale(1.3);
	}

	.drop[data-state="paused"] .card:not(.is-expanded) {
		opacity: 0.45;
		transition: opacity 0.5s ease;
	}

	.drop[data-state="running"] .card {
		opacity: 1;
		transition: opacity 0.5s ease;
	}

	.card__btn {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		width: 100%;
		text-align: left;
		color: inherit;
		/* allow the wrap's pointer handlers to consume drag */
		touch-action: pan-y;
	}

	.card__figure {
		position: relative;
		margin: 0;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--chrome-1);
	}

	.card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 25%;
		filter: saturate(0.95) contrast(1.02);
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1), filter 0.5s ease;
		pointer-events: none;
		-webkit-user-drag: none;
	}

	.card.is-expanded .card__img {
		filter: saturate(1.08) contrast(1.06);
	}

	.card__base {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.card__idx {
		font-size: 0.62rem;
		letter-spacing: 0.18em;
		opacity: 0.55;
	}

	.card__name {
		margin: 0;
		font-size: clamp(0.9rem, 1.2vw, 1.1rem);
		letter-spacing: 0.16em;
	}

	.card__meta {
		display: flex;
		gap: 0.4rem;
		font-size: 0.58rem;
		opacity: 0.7;
		letter-spacing: 0.12em;
		align-items: center;
		flex-wrap: wrap;
	}

	.dot {
		opacity: 0.4;
	}

	/* ---- inline expansion panel ---- */
	.card__details {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition: grid-template-rows 0.55s cubic-bezier(0.2, 0.7, 0.1, 1),
			opacity 0.4s ease;
	}

	.card.is-expanded .card__details {
		grid-template-rows: 1fr;
		opacity: 1;
		transition-delay: 0.15s, 0.2s;
	}

	.card__details-inner {
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--rule);
		margin-top: 0.3rem;
	}

	.card__summary {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.62rem;
		line-height: 1.55;
		opacity: 0.78;
	}

	.card__mat-label {
		margin: 0;
		opacity: 0.4;
		font-size: 0.52rem;
	}

	.card__materials {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		font-size: 0.55rem;
		letter-spacing: 0.06em;
	}

	.card__materials li::before {
		content: "·";
		opacity: 0.5;
		display: inline-block;
		width: 0.8em;
	}

	.card__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.4rem;
		padding: 0.55rem 0.85rem;
		font-size: 0.55rem;
		letter-spacing: 0.22em;
		background: var(--ink);
		color: var(--bone);
		align-self: start;
		position: relative;
		overflow: hidden;
		transition: color 0.4s ease;
	}

	.card__cta::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--acid);
		transform: translateY(101%);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.card__cta > * {
		position: relative;
		z-index: 1;
	}

	.card__cta:hover {
		color: var(--ink);
	}

	.card__cta:hover::before {
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.drop__shift,
		.card,
		.card__details {
			transition: none;
		}
	}

	@media (max-width: 720px) {
		.drop__head {
			flex-direction: column;
			align-items: start;
		}
		.drop__head-right {
			text-align: left;
		}
		.card.is-expanded {
			transform: scale(1.15);
		}
	}
</style>
