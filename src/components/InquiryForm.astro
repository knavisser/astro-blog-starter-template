---
import Icon from "./Icon.astro";
---

<form class="inquiry" id="inquiry" novalidate>
	<!-- honeypot -->
	<label class="hp" aria-hidden="true" tabindex="-1">
		Don't fill this out: <input type="text" name="company" autocomplete="off" />
	</label>

	<fieldset class="field-group">
		<legend class="mono">// IDENTITY</legend>
		<div class="row">
			<label class="field">
				<span class="mono label">NAME</span>
				<input type="text" name="name" required placeholder="your name" data-cursor="link" />
			</label>
			<label class="field">
				<span class="mono label">TELEGRAM</span>
				<input
					type="text"
					name="telegram"
					required
					placeholder="@handle"
					pattern="@?[A-Za-z0-9_]{3,}"
					autocapitalize="off"
					autocomplete="off"
					data-cursor="link"
				/>
			</label>
		</div>
		<label class="field">
			<span class="mono label">COUNTRY</span>
			<input
				type="text"
				name="country"
				required
				placeholder="for shipping quote"
				data-cursor="link"
			/>
		</label>
	</fieldset>

	<fieldset class="field-group">
		<legend class="mono">// SPEC</legend>

		<label class="check">
			<input
				type="checkbox"
				name="basedOnCharacter"
				value="yes"
				class="character-toggle"
				data-cursor="link"
			/>
			<span class="mono check__label"
				>My hoodie is based on a (custom) character</span
			>
		</label>

		<label class="field character-upload">
			<span class="mono label">CHARACTER REFERENCES</span>
			<span class="upload-hint mono"
				>Add references of your character here.</span
			>
			<input
				type="file"
				name="characterRefs"
				multiple
				accept="image/*,application/pdf"
				class="file-input"
				data-cursor="link"
			/>
		</label>

		<div class="row">
			<label class="field">
				<span class="mono label">EAR SHAPE</span>
				<select name="earStyle" required data-cursor="link">
					<option value="">choose…</option>
					<option value="Canine">Canine</option>
					<option value="Draconid">Draconid</option>
					<option value="Feline">Feline</option>
					<option value="Hyenid">Hyenid</option>
					<option value="Jolteon">Jolteon</option>
					<option value="Marsupial">Marsupial</option>
					<option value="From scratch">From scratch (new pattern)</option>
					<option value="Other">Other — describe in notes</option>
				</select>
			</label>
			<label class="field">
				<span class="mono label">SIZE</span>
				<select name="size" required data-cursor="link">
					<option value="">choose…</option>
					<option value="XS">XS</option>
					<option value="S">S</option>
					<option value="M">M</option>
					<option value="L">L</option>
					<option value="XL">XL</option>
					<option value="XXL">XXL</option>
					<option value="3XL">3XL</option>
				</select>
			</label>
		</div>

		<label class="field">
			<span class="mono label">MODIFICATIONS / DETAILS</span>
			<textarea
				name="modifications"
				rows="4"
				placeholder="silhouette, ears, horns, hardware, weathering, stitching, references…"
				data-cursor="link"></textarea>
			<input
				type="file"
				name="modificationRefs"
				multiple
				accept="image/*,application/pdf"
				class="file-input"
				data-cursor="link"
			/>
		</label>
	</fieldset>

	<fieldset class="field-group">
		<legend class="mono">// BUDGET</legend>
		<div class="budgets" role="radiogroup" aria-label="Budget tier">
			<label class="budget">
				<input type="radio" name="budget" value="under-150" data-cursor="link" />
				<span><strong>UNDER €150</strong><em>simple modifications</em></span>
			</label>
			<label class="budget">
				<input type="radio" name="budget" value="150-200" data-cursor="link" />
				<span
					><strong>€150 – €200</strong><em
						>custom horn/ear, cropping, hardware</em
					></span
				>
			</label>
			<label class="budget">
				<input type="radio" name="budget" value="200-plus" data-cursor="link" />
				<span
					><strong>€200+</strong><em
						>full custom build — choose your brand</em
					></span
				>
			</label>
			<label class="budget">
				<input type="radio" name="budget" value="open" data-cursor="link" />
				<span><strong>OPEN</strong><em>let's talk</em></span>
			</label>
		</div>
	</fieldset>

	<fieldset class="field-group">
		<legend class="mono">// NOTES</legend>
		<label class="field">
			<textarea
				name="notes"
				rows="3"
				placeholder="sizing quirks, references — we modify existing silhouettes, not from scratch"
				data-cursor="link"></textarea>
		</label>
	</fieldset>

	<div class="submit-row">
		<button type="submit" class="submit" data-cursor="link">
			<span class="submit__label">SEND THE SUMMONS</span>
			<Icon name="arrow-up-right" size={18} />
		</button>
		<p class="mono submit__note">
			You'll hear back within 48 hours. Submitting a quote does not guarantee
			custom work.
		</p>
	</div>

	<div class="result mono" id="inquiry-result" aria-live="polite" hidden></div>
</form>

<script>
	function bindForm() {
		const form = document.getElementById("inquiry") as HTMLFormElement | null;
		const result = document.getElementById("inquiry-result");
		if (!form || !result) return;

		const MAX_TOTAL_BYTES = 25 * 1024 * 1024;

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			result.hidden = false;
			result.textContent = "SENDING…";
			result.removeAttribute("data-state");

			const fd = new FormData(form);

			let totalBytes = 0;
			for (const value of fd.values()) {
				if (value instanceof File) totalBytes += value.size;
			}
			if (totalBytes > MAX_TOTAL_BYTES) {
				result.setAttribute("data-state", "error");
				result.textContent =
					"// FILES TOO LARGE — KEEP ATTACHMENTS UNDER 25MB TOTAL.";
				return;
			}

			try {
				const res = await fetch("/api/inquiry", {
					method: "POST",
					body: fd,
				});
				const data = (await res.json()) as { ok: boolean; error?: string };
				if (!res.ok || !data.ok) {
					throw new Error(data.error || "Could not send.");
				}
				result.setAttribute("data-state", "success");
				result.textContent = "// SUMMONS RECEIVED. WE'LL BE IN TOUCH WITHIN 48 HOURS.";
				form.reset();
			} catch (err) {
				result.setAttribute("data-state", "error");
				result.textContent = `// FAILED — ${err instanceof Error ? err.message : "try again."}`;
			}
		});
	}

	bindForm();
	document.addEventListener("astro:after-swap", bindForm);
</script>

<style>
	.inquiry {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		color: var(--ink);
	}

	.hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.field-group {
		border: 0;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	legend {
		opacity: 0.5;
		font-size: 0.7rem;
		padding: 0;
		margin-bottom: var(--space-1);
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.label {
		font-size: 0.6rem;
		opacity: 0.55;
	}

	input[type="text"],
	input[type="email"],
	input[type="date"],
	select,
	textarea {
		font: inherit;
		font-family: var(--font-body);
		font-size: 0.95rem;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--rule-strong);
		padding: 0.55rem 0;
		transition: border-color 0.25s ease;
	}

	textarea {
		resize: vertical;
		min-height: 4rem;
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--ink);
		opacity: 0.35;
	}

	input:focus,
	select:focus,
	textarea:focus {
		border-color: var(--ink);
		outline: none;
	}

	.check {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
		padding: 0.4rem 0;
	}

	.check input {
		width: 1rem;
		height: 1rem;
		accent-color: var(--ink);
		margin: 0;
	}

	.check__label {
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}

	.character-upload {
		display: none;
	}

	.field-group:has(.character-toggle:checked) .character-upload {
		display: flex;
		margin-bottom: 1.25rem;
	}

	.upload-hint {
		font-size: 0.62rem;
		opacity: 0.55;
		letter-spacing: 0.04em;
		margin-top: -0.1rem;
	}

	.file-input {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink);
		padding: 0.4rem 0;
		border: 0;
		border-bottom: 1px dashed var(--rule-strong);
		background: transparent;
		transition: border-color 0.25s ease;
	}

	.file-input::file-selector-button {
		font: inherit;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink);
		background: transparent;
		border: 1px solid var(--rule-strong);
		padding: 0.4rem 0.8rem;
		margin-right: 0.6rem;
		cursor: pointer;
		transition: border-color 0.25s ease, background 0.25s ease;
	}

	.file-input::file-selector-button:hover {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--bone);
	}

	.budgets {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
	}

	.budget {
		cursor: pointer;
	}

	.budget input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.budget span {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--rule);
		transition: border-color 0.25s ease, background 0.25s ease;
	}

	.budget strong {
		font-family: var(--font-display);
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		font-weight: 400;
	}

	.budget em {
		font-style: normal;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		opacity: 0.6;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.budget:hover span {
		border-color: var(--ink);
	}

	.budget input:checked + span {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--bone);
	}

	.budget input:checked + span em {
		opacity: 0.7;
	}

	.submit-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-2);
		flex-wrap: wrap;
	}

	.submit {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 1.1rem 2rem;
		font-family: var(--font-display);
		font-size: 0.78rem;
		letter-spacing: 0.3em;
		background: var(--ink);
		color: var(--bone);
		border: 1px solid var(--ink);
		position: relative;
		overflow: hidden;
		transition: color 0.4s ease;
	}

	.submit::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--acid);
		transform: translateY(101%);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
		z-index: 0;
	}

	.submit > * {
		position: relative;
		z-index: 1;
	}

	.submit:hover {
		color: var(--ink);
	}

	.submit:hover::before {
		transform: translateY(0);
	}

	.submit__note {
		opacity: 0.5;
		font-size: 0.62rem;
	}

	.result {
		padding: 0.9rem 1.2rem;
		border: 1px solid var(--rule);
		font-size: 0.7rem;
	}

	.result[data-state="success"] {
		border-color: var(--acid-dim);
		background: rgba(198, 255, 0, 0.12);
	}

	.result[data-state="error"] {
		border-color: rgba(180, 30, 30, 0.6);
		background: rgba(180, 30, 30, 0.06);
	}

	@media (max-width: 800px) {
		.row {
			grid-template-columns: 1fr;
		}
		.budgets {
			grid-template-columns: 1fr;
		}
	}
</style>
