---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Cardinal from "../components/sigils/Cardinal.astro";
import ToastStack from "../components/ToastStack.astro";
import { objectLabel, PHOTO_WIDTHS } from "../consts";
import { hoodies, collections, collectionOf } from "../lib/hoodies";
import { coverSizes, type Box } from "../lib/cover-sizes";

// One grid: featured pieces always lead, everything else follows. Within each
// group pieces are ordered by number. The status pill is the only divider.
const orderedHoodies = [...hoodies].sort((a, b) => {
	const aLead = a.status === "featured" ? 0 : 1;
	const bLead = b.status === "featured" ? 0 : 1;
	return aLead - bLead || a.number - b.number;
});

const stats = {
	total: hoodies.length,
	featured: hoodies.filter((h) => h.status === "featured").length,
	archive: hoodies.filter((h) => h.status === "archive").length,
};

const pad = (n: number) => String(n).padStart(3, "0");

// Mosaic rhythm by position. Tall takes priority so no tile is ever both tall
// and wide (a 3×2 block can't backfill the grid and orphans). The filter
// script below reapplies the same rhythm to whichever tiles are visible.
type Shape = "normal" | "tall" | "wide";
const shapeAt = (i: number): Shape => (i % 3 === 1 ? "tall" : i % 5 === 4 ? "wide" : "normal");

// How wide each tile shape is and how it's shaped (width / height), so every
// cover gets a file wide enough for how far it's cropped. A tall tile spans
// two rows of normal tiles, which makes it far narrower than its 4:7 minimum.
const tileBoxes: Record<Shape, Box[]> = {
	normal: [
		{ media: "(max-width: 1100px)", width: "50vw", ratio: 4 / 5 },
		{ width: "33vw", ratio: 4 / 5 },
	],
	tall: [
		{ media: "(max-width: 720px)", width: "100vw", ratio: 4 / 7 },
		{ media: "(max-width: 1100px)", width: "50vw", ratio: 0.36 },
		{ width: "33vw", ratio: 0.36 },
	],
	wide: [
		{ media: "(max-width: 720px)", width: "100vw", ratio: 21 / 12 },
		{ media: "(max-width: 1100px)", width: "75vw", ratio: 21 / 12 },
		{ width: "50vw", ratio: 21 / 12 },
	],
};
// a cover's sizes in each shape; the filter script below swaps them as tiles change shape
const tileSizes = (cover: ImageMetadata) =>
	Object.fromEntries(
		Object.entries(tileBoxes).map(([shape, boxes]) => [shape, coverSizes(cover.width / cover.height, boxes)])
	) as Record<Shape, string>;
---

<Base
	title="portfolio"
	description="one of one hoodies. a portfolio of current and archived pieces."
>
	<section class="hero-strip">
		<div class="hero-strip__inner">
			<p class="mono kicker" data-reveal>// PORTFOLIO</p>
			<h1 class="display title" data-reveal>THE · COLLECTION</h1>
			<p class="lede" data-reveal>
				A showcase of one-of-one pieces, current and archived. Bespoke
				commissions by inquiry.
			</p>

			<dl class="stats mono" data-reveal-stagger>
				<div>
					<dt>// TOTAL</dt>
					<dd>{pad(stats.total)}</dd>
				</div>
				<div>
					<dt>// FEATURED</dt>
					<dd>{pad(stats.featured)}</dd>
				</div>
				<div>
					<dt>// ARCHIVED</dt>
					<dd>{pad(stats.archive)}</dd>
				</div>
			</dl>

			<Cardinal size={220} class="divider" />
		</div>
	</section>

	{
		collections.length > 0 && (
			<section class="collections" aria-labelledby="collections-title">
				<div class="collections__inner">
					<div class="collections__head">
						<h2 class="mono kicker" id="collections-title">
							// COLLECTIONS
						</h2>
						<a
							class="mono filter-all is-active"
							href="/portfolio"
							data-filter=""
							data-cursor="link"
							aria-current="true"
						>
							ALL <span class="filter-all__count">{pad(hoodies.length)}</span>
						</a>
					</div>

					<ul class="collections__list">
						{collections.map((collection) => (
							<li>
								<a
									class="collection"
									href={`/portfolio?collection=${collection.key}`}
									data-filter={collection.key}
									data-filter-name={collection.name}
									data-cursor="zoom"
									data-cursor-label="FILTER"
								>
									{collection.cover && (
										<Image
											class="collection__img"
											src={collection.cover}
											alt=""
											widths={PHOTO_WIDTHS}
											sizes="(max-width: 1680px) 100vw, 1680px"
										/>
									)}
									<span class="collection__veil" aria-hidden="true" />
									<span class="display collection__name">{collection.name}</span>
									<span class="mono collection__meta">
										<span>{pad(collection.count)} PIECES</span>
										{collection.date && <span>{collection.date}</span>}
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="section">
		<p class="mono grid-status" data-grid-status aria-live="polite">
			SHOWING {pad(hoodies.length)} OF {pad(hoodies.length)}
		</p>
		<ol class="grid" data-grid>
			{
				orderedHoodies.map((hoodie, i) => {
					const shape = shapeAt(i);
					const sizes = tileSizes(hoodie.cover);
					const collection = collectionOf(hoodie);
					return (
						<li
							class:list={["tile", { "tile--tall": shape === "tall", "tile--wide": shape === "wide" }]}
							data-collection={hoodie.collection ?? ""}
						>
							<a
								class="tile__link"
								href={`/portfolio/${hoodie.id}`}
								data-cursor="zoom"
								data-cursor-label="VIEW"
							>
								<figure class="tile__figure">
									<Image
										class="tile__img"
										src={hoodie.cover}
										alt={objectLabel(hoodie.number)}
										widths={PHOTO_WIDTHS}
										sizes={sizes[shape]}
										data-sizes={JSON.stringify(sizes)}
										loading={i < 3 ? "eager" : "lazy"}
									/>
									<span class:list={["mono", "tile__status", `is-${hoodie.status}`]}>
										{hoodie.status.toUpperCase()}
									</span>
								</figure>
								<div class="tile__caption mono">
									<span class="tile__idx">/// {hoodie.id}</span>
									<span class="tile__name">{objectLabel(hoodie.number)}</span>
									<span class="tile__sub">
										{[collection?.name, hoodie.completed].filter(Boolean).join(" · ")}
									</span>
								</div>
							</a>
						</li>
					);
				})
			}
		</ol>
	</section>

	<ToastStack />
</Base>

<script>
	// Collection filter. The links stay real (/portfolio?collection=ndsm can be
	// shared or opened in a new tab), but a plain click filters in place.
	function bindCollectionFilter() {
		const grid = document.querySelector<HTMLElement>("[data-grid]");
		if (!grid) return;
		const tiles = Array.from(grid.querySelectorAll<HTMLElement>(".tile"));
		const filters = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-filter]"));
		const status = document.querySelector<HTMLElement>("[data-grid-status]");
		const known = new Set(filters.map((f) => f.dataset.filter ?? ""));
		const pad = (n: number) => String(n).padStart(3, "0");
		let current = "";

		const apply = (key: string, animate: boolean) => {
			current = known.has(key) ? key : "";
			let shown = 0;
			for (const tile of tiles) {
				const visible = !current || tile.dataset.collection === current;
				tile.hidden = !visible;
				if (!visible) continue;
				// same rhythm as the server render, counted over visible tiles
				const shape = shown % 3 === 1 ? "tall" : shown % 5 === 4 ? "wide" : "normal";
				tile.classList.toggle("tile--tall", shape === "tall");
				tile.classList.toggle("tile--wide", shape === "wide");
				// the cover's sizes for its new shape, worked out per photo at build time
				const img = tile.querySelector("img");
				const sizes = JSON.parse(img?.dataset.sizes ?? "{}") as Record<string, string>;
				if (img && sizes[shape]) img.sizes = sizes[shape];
				if (animate) {
					tile.classList.remove("is-entering");
					void tile.offsetWidth;
					tile.style.setProperty("--enter-delay", `${Math.min(shown, 10) * 35}ms`);
					tile.classList.add("is-entering");
				}
				shown++;
			}
			for (const filter of filters) {
				const active = (filter.dataset.filter ?? "") === current;
				filter.classList.toggle("is-active", active);
				if (active) filter.setAttribute("aria-current", "true");
				else filter.removeAttribute("aria-current");
			}
			if (status) {
				const name = filters.find((f) => f.dataset.filter === current)?.dataset.filterName;
				status.textContent =
					`SHOWING ${pad(shown)} OF ${pad(tiles.length)}` + (current && name ? ` · ${name}` : "");
			}
		};

		for (const filter of filters) {
			filter.addEventListener("click", (e) => {
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				const key = filter.dataset.filter ?? "";
				// clicking the active collection again goes back to everything
				apply(key === current ? "" : key, true);

				const url = new URL(location.href);
				if (current) url.searchParams.set("collection", current);
				else url.searchParams.delete("collection");
				history.replaceState(history.state, "", url);

				// bring the grid into view if the change happened below the fold
				if (status && status.getBoundingClientRect().top > window.innerHeight * 0.75) {
					const lenis = (window as any).__lenis;
					if (lenis) lenis.scrollTo(status, { offset: -96 });
					else status.scrollIntoView({ behavior: "smooth", block: "start" });
				}
			});
		}

		apply(new URLSearchParams(location.search).get("collection") ?? "", false);
	}

	bindCollectionFilter();
	document.addEventListener("astro:after-swap", bindCollectionFilter);
</script>

<style>
	.hero-strip {
		padding: calc(var(--header-h) + var(--space-6)) var(--gutter) var(--space-5);
		background: var(--bone);
	}

	.hero-strip__inner {
		max-width: var(--max-w);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-2);
	}

	.kicker {
		opacity: 0.5;
		font-size: 0.7rem;
		font-weight: 400;
		margin: 0;
	}

	.title {
		margin: 0;
		font-size: clamp(2.4rem, 7vw, 6rem);
		letter-spacing: 0.06em;
	}

	.lede {
		max-width: 52ch;
		font-size: 0.95rem;
		opacity: 0.7;
		margin: 0;
		line-height: 1.55;
	}

	.stats {
		display: flex;
		gap: var(--space-5);
		margin: var(--space-4) 0 0;
		font-size: 0.7rem;
		padding: 0;
	}

	.stats > div {
		text-align: center;
	}

	.stats dt {
		opacity: 0.45;
		margin-bottom: 0.3rem;
	}

	.stats dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.3rem;
		letter-spacing: 0.12em;
	}

	:global(.hero-strip .divider) {
		color: var(--chrome-3);
		opacity: 0.6;
		margin-top: var(--space-3);
	}

	/* ---- collections ---- */
	.collections {
		padding: 0 var(--gutter) var(--space-4);
		background: var(--bone);
	}

	.collections__inner {
		max-width: var(--max-w);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.collections__head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2);
	}

	.filter-all {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.55rem 0.85rem;
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		border: 1px solid var(--rule-strong);
		color: var(--ink);
		transition: background 0.25s ease, color 0.25s ease;
	}

	.filter-all:hover,
	.filter-all.is-active {
		background: var(--ink);
		color: var(--bone);
	}

	.filter-all__count {
		opacity: 0.55;
	}

	.collections__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: var(--space-3);
	}

	.collection {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 3 / 1;
		background: var(--ink);
		color: var(--bone);
	}

	.collection__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		filter: grayscale(0.15);
		transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.1, 1), filter 0.6s ease;
	}

	.collection:hover .collection__img {
		transform: scale(1.03);
		filter: grayscale(0);
	}

	.collection__veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(10, 9, 8, 0.78), rgba(10, 9, 8, 0) 65%);
	}

	.collection__name {
		position: absolute;
		left: var(--space-3);
		bottom: var(--space-3);
		font-size: clamp(2rem, 6vw, 5rem);
		letter-spacing: 0.08em;
		line-height: 1;
		transition: color 0.3s ease;
	}

	.collection__meta {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-3);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.3rem;
		font-size: 0.65rem;
		letter-spacing: 0.18em;
	}

	/* active collection: acid name plus a bar that wipes in along the bottom */
	.collection::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 4px;
		background: var(--acid);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.collection.is-active::after {
		transform: scaleX(1);
	}

	.collection.is-active .collection__name {
		color: var(--acid);
	}

	/* ---- collection grid ---- */
	.section {
		padding: var(--space-4) var(--gutter) var(--space-8);
		background: var(--bone);
	}

	.grid-status {
		max-width: var(--max-w);
		margin: 0 auto var(--space-3);
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		opacity: 0.55;
	}

	/* ---- standard grid (all pieces, featured first) ---- */
	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: var(--max-w);
		margin-inline: auto;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: var(--space-3);
		grid-auto-flow: dense;
	}

	.tile {
		grid-column: span 2;
	}

	.tile[hidden] {
		display: none;
	}

	.tile--tall {
		grid-row: span 2;
	}

	.tile--wide {
		grid-column: span 3;
	}

	.tile.is-entering {
		animation: tile-in 0.6s cubic-bezier(0.2, 0.7, 0.1, 1) var(--enter-delay, 0ms) both;
	}

	@keyframes tile-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	.tile__link {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		height: 100%;
	}

	.tile__figure {
		position: relative;
		margin: 0;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--chrome-1);
		flex: 1;
	}

	.tile--tall .tile__figure {
		aspect-ratio: 4 / 7;
	}

	.tile--wide .tile__figure {
		aspect-ratio: 21 / 12;
	}

	.tile__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 28%;
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.tile:hover .tile__img {
		transform: scale(1.05);
	}

	.tile__status {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		font-size: 0.55rem;
		padding: 0.25rem 0.55rem;
		background: rgba(244, 241, 236, 0.92);
		color: var(--ink);
		letter-spacing: 0.18em;
		border: 1px solid rgba(10, 9, 8, 0.1);
	}

	.tile__status.is-featured {
		background: var(--bone);
		color: var(--ink);
		border: 1px solid var(--acid);
	}

	.tile__status.is-archive {
		background: rgba(10, 9, 8, 0.85);
		color: var(--bone);
	}

	.tile__caption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
	}

	.tile__idx {
		opacity: 0.5;
		font-size: 0.6rem;
	}

	.tile__name {
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.16em;
	}

	.tile__sub {
		opacity: 0.55;
		font-size: 0.6rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.tile.is-entering {
			animation: none;
		}
		.collection__img,
		.collection::after {
			transition: none;
		}
	}

	@media (max-width: 1100px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 720px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.tile {
			grid-column: span 1;
		}
		.tile--wide,
		.tile--tall {
			grid-column: span 2;
			grid-row: auto;
		}
		.stats {
			gap: var(--space-3);
		}
		.collection {
			aspect-ratio: 4 / 3;
		}
		.collection__name {
			left: var(--space-2);
			bottom: var(--space-2);
		}
		.collection__meta {
			right: var(--space-2);
			bottom: var(--space-2);
		}
	}
</style>
