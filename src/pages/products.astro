---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import Cardinal from "../components/sigils/Cardinal.astro";
import ToastStack from "../components/ToastStack.astro";
import { SHOP_URL } from "../consts";

const pieces = await getCollection("pieces");

const featuredPieces = pieces
	.filter((p) => p.data.status === "featured")
	.sort((a, b) => a.data.index - b.data.index);

const archivePieces = pieces
	.filter((p) => p.data.status === "archive")
	.sort((a, b) => a.data.index - b.data.index);

const stats = {
	total: pieces.length,
	featured: featuredPieces.length,
	archive: archivePieces.length,
};
---

<Base
	title="products"
	description="one of one hoodies. available now and from the archive."
>
	<section class="hero-strip">
		<div class="hero-strip__inner">
			<p class="mono kicker" data-reveal>// PORTFOLIO · PRODUCTS</p>
			<h1 class="display title" data-reveal>THE · COLLECTION</h1>
			<p class="lede" data-reveal>
				A showcase of one-of-one pieces — current and archived. To buy what's in
				stock, visit the shop. Bespoke commissions by inquiry.
			</p>

			<a
				class="shop-cta mono"
				href={SHOP_URL}
				target="_blank"
				rel="noopener noreferrer"
				data-cursor="link"
				data-reveal
			>
				<span>SHOP THE COLLECTION</span>
				<span class="shop-cta-arrow" aria-hidden="true">→</span>
			</a>

			<dl class="stats mono" data-reveal-stagger>
				<div>
					<dt>// TOTAL</dt>
					<dd>{String(stats.total).padStart(3, "0")}</dd>
				</div>
				<div>
					<dt>// FEATURED</dt>
					<dd>{String(stats.featured).padStart(3, "0")}</dd>
				</div>
				<div>
					<dt>// ARCHIVED</dt>
					<dd>{String(stats.archive).padStart(3, "0")}</dd>
				</div>
			</dl>

			<Cardinal size={220} class="divider" />
		</div>
	</section>

	<section class="section section--featured">
		<header class="section__head">
			<p class="mono section__kicker">// I. FEATURED</p>
			<h2 class="display section__title">FEATURED · PIECES</h2>
		</header>

		<ol class="grid">
			{
				featuredPieces.map((piece, i) => (
					<li
						class:list={[
							"tile",
							{ "tile--tall": i % 3 === 1, "tile--wide": i % 5 === 4 },
						]}
					>
						<a
							class="tile__link"
							href={`/products/${piece.id}`}
							data-cursor="zoom"
							data-cursor-label="VIEW"
						>
							<figure class="tile__figure">
								<img
									class="tile__img"
									src={piece.data.heroImage}
									alt={piece.data.name}
									loading={i < 3 ? "eager" : "lazy"}
								/>
								<span
									class:list={[
										"mono",
										"tile__status",
										`is-${piece.data.status}`,
									]}
								>
									{piece.data.status.toUpperCase()}
								</span>
							</figure>
							<div class="tile__caption mono">
								<span class="tile__idx">
									/// {String(piece.data.index).padStart(3, "0")}
								</span>
								<span class="tile__name">{piece.data.name}</span>
								<span class="tile__sub">
									{piece.data.earStyle.toUpperCase()} · DIY STITCH
								</span>
							</div>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section section--archive">
		<header class="section__head">
			<p class="mono section__kicker">// II. ARCHIVE</p>
			<h2 class="display section__title">ARCHIVE · PIECES</h2>
		</header>

		<ol class="grid">
			{
				archivePieces.map((piece, i) => (
					<li
						class:list={[
							"tile",
							{ "tile--tall": i % 3 === 1, "tile--wide": i % 5 === 4 },
						]}
					>
						<a
							class="tile__link"
							href={`/products/${piece.id}`}
							data-cursor="zoom"
							data-cursor-label="VIEW"
						>
							<figure class="tile__figure">
								<img
									class="tile__img"
									src={piece.data.heroImage}
									alt={piece.data.name}
									loading={i < 3 ? "eager" : "lazy"}
								/>
								<span
									class:list={[
										"mono",
										"tile__status",
										`is-${piece.data.status}`,
									]}
								>
									{piece.data.status.toUpperCase()}
								</span>
							</figure>
							<div class="tile__caption mono">
								<span class="tile__idx">
									/// {String(piece.data.index).padStart(3, "0")}
								</span>
								<span class="tile__name">{piece.data.name}</span>
								<span class="tile__sub">
									{piece.data.earStyle.toUpperCase()} · DIY STITCH
								</span>
							</div>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<ToastStack />
</Base>

<style>
	.hero-strip {
		padding: calc(var(--header-h) + var(--space-6)) var(--gutter) var(--space-5);
		background: var(--bone);
	}

	.hero-strip__inner {
		max-width: var(--max-w);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-2);
	}

	.kicker {
		opacity: 0.5;
		font-size: 0.7rem;
		margin: 0;
	}

	.title {
		margin: 0;
		font-size: clamp(2.4rem, 7vw, 6rem);
		letter-spacing: 0.06em;
	}

	.lede {
		max-width: 52ch;
		font-size: 0.95rem;
		opacity: 0.7;
		margin: 0;
		line-height: 1.55;
	}

	/* primary conversion CTA → SumUp shop (mirrors .empty__cta treatment) */
	.shop-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: var(--space-3);
		padding: 0.75rem 1.2rem;
		font-size: 0.65rem;
		letter-spacing: 0.22em;
		color: var(--bone);
		background: var(--ink);
		position: relative;
		overflow: hidden;
		transition: color 0.4s ease;
	}

	.shop-cta::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--acid);
		transform: translateY(101%);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
		z-index: 0;
	}

	.shop-cta > * {
		position: relative;
		z-index: 1;
	}

	.shop-cta:hover {
		color: var(--ink);
	}

	.shop-cta:hover::before {
		transform: translateY(0);
	}

	.shop-cta-arrow {
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.shop-cta:hover .shop-cta-arrow {
		transform: translateX(4px);
	}

	.stats {
		display: flex;
		gap: var(--space-5);
		margin: var(--space-4) 0 0;
		font-size: 0.7rem;
		padding: 0;
	}

	.stats > div {
		text-align: center;
	}

	.stats dt {
		opacity: 0.45;
		margin-bottom: 0.3rem;
	}

	.stats dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.3rem;
		letter-spacing: 0.12em;
	}

	:global(.hero-strip .divider) {
		color: var(--chrome-3);
		opacity: 0.6;
		margin-top: var(--space-3);
	}

	/* ---- sections ---- */
	.section {
		padding: var(--space-5) var(--gutter) var(--space-6);
		background: var(--bone);
	}

	.section--archive {
		padding-bottom: var(--space-8);
	}

	.section__head {
		max-width: var(--max-w);
		margin: 0 auto var(--space-4);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		border-top: 1px solid var(--rule);
		padding-top: var(--space-4);
	}

	.section__kicker {
		opacity: 0.5;
		font-size: 0.7rem;
		margin: 0;
	}

	.section__title {
		margin: 0;
		font-size: clamp(1.6rem, 3.5vw, 2.6rem);
		letter-spacing: 0.08em;
	}

	/* ---- standard grid (featured + archive) ---- */
	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: var(--max-w);
		margin-inline: auto;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: var(--space-3);
		grid-auto-flow: dense;
	}

	.tile {
		grid-column: span 2;
	}

	.tile--tall {
		grid-row: span 2;
	}

	.tile--wide {
		grid-column: span 3;
	}

	.tile__link {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		height: 100%;
	}

	.tile__figure {
		position: relative;
		margin: 0;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--chrome-1);
		flex: 1;
	}

	.tile--tall .tile__figure {
		aspect-ratio: 4 / 7;
	}

	.tile--wide .tile__figure {
		aspect-ratio: 21 / 12;
	}

	.tile__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 28%;
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
	}

	.tile:hover .tile__img {
		transform: scale(1.05);
	}

	.tile__status {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		font-size: 0.55rem;
		padding: 0.25rem 0.55rem;
		background: rgba(244, 241, 236, 0.92);
		color: var(--ink);
		letter-spacing: 0.18em;
		border: 1px solid rgba(10, 9, 8, 0.1);
	}

	.tile__status.is-featured {
		background: var(--bone);
		color: var(--ink);
		border: 1px solid var(--acid);
	}

	.tile__status.is-archive {
		background: rgba(10, 9, 8, 0.85);
		color: var(--bone);
	}

	.tile__caption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
	}

	.tile__idx {
		opacity: 0.5;
		font-size: 0.6rem;
	}

	.tile__name {
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.16em;
	}

	.tile__sub {
		opacity: 0.55;
		font-size: 0.6rem;
	}

	@media (max-width: 1100px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 720px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.tile {
			grid-column: span 1;
		}
		.tile--wide,
		.tile--tall {
			grid-column: span 2;
			grid-row: auto;
		}
		.stats {
			gap: var(--space-3);
		}
		.available-grid--hero-pair {
			grid-template-columns: minmax(0, 1fr);
		}
		.empty {
			padding: var(--space-5) var(--space-3);
		}
	}
</style>
